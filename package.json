{
  "name": "arotationhelper",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "addon:build": "node ./tools/apl2lua/apl2lua.mjs --spec monk/brewmaster --preset default",
